# Local dev: point at a throwaway local Postgres.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fronttech_test"

# Production (Render): set this to the real Neon connection string in the
# Render service's Environment tab, not here. Use the Pooled connection
# string from Neon's Connection Details (PgBouncer, transaction mode) --
# that's what the app should use at runtime via @prisma/adapter-pg.
#
# One exception: if you ever need to run `prisma migrate deploy` by hand
# against Neon (rather than through Render's build step, which already runs
# it), Neon's own guidance is that schema migrations can be unreliable
# through the pooler -- use the Direct connection string for that one
# operation, then switch back to the pooled string for everyday use.
